{
  "manifest_version": 3,
  "name": "AI-Chat-Room",
  "version": "1.8.0",
  "description": "AI-Chat-Room：观察看板网站列表里的 AI 网站页面 DOM（默认 ChatGPT / Duck.ai / Hark，可编辑、停用、删除、添加），通过 WebSocket 上报到本地 Node.js 后端，并接收后端指令。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.hark.com/*",
    "https://hark.com/*",
    "https://duck.ai/*",
    "https://muse.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI-Chat-Room"
  }
}
