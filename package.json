{
  "name": "ai-chat-room",
  "version": "0.1.0",
  "private": true,
  "description": "web ai chat admin：网页 AI 对话 → Chrome 插件（frontend）→ 本地监听后端（backend，SQLite + WebSocket 广播 + 看板）",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "pnpm --filter @ai-chat-room/backend start",
    "build": "node scripts/export-schema.js && node scripts/sync-shared.js",
    "build:schema": "node scripts/export-schema.js",
    "build:ext": "node scripts/sync-shared.js",
    "observer": "node scripts/observer-client.js",
    "test": "pnpm build && node --test --test-concurrency=1 'tests/unit/*.test.js' 'tests/integration/*.test.js' 'tests/e2e/*.test.js'",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:frontend": "pnpm build && node --test --test-concurrency=1 tests/integration/observer.test.js tests/integration/sites.test.js",
    "test:backend": "pnpm build && node --test --test-concurrency=1 'tests/unit/*.test.js' tests/integration/dom-config.test.js tests/integration/dashboard.test.js 'tests/e2e/*.test.js'",
    "lint": "eslint .",
    "check-syntax": "find contracts src scripts tests -name '*.js' -not -path '*/node_modules/*' -not -path '*/shared/*' -exec node --check {} + && node --check eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.2",
    "ws": "^8.22.0"
  }
}
